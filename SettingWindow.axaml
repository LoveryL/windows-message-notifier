<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Notifier"
        x:Class="Notifier.SettingWindow"
        Title="控制中心"
        Width="370" Height="315"
        MinWidth="370" MinHeight="315"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        SystemDecorations="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Notifier/ThemeResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:PlayPauseTextToStateConverter x:Key="PlayPauseConverter" />
            <local:PlayPauseToVisibilityConverter x:Key="PlayPauseToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <Border CornerRadius="14"
                Background="{DynamicResource LiquidGlassBackground}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 0 24 0 #00000040">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="14,10">
                    <TextBlock Text="控制中心" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource LiquidGlassForeground}" />
                </Border>

                <StackPanel Grid.Row="1" Margin="22,20,22,10" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{DynamicResource IconSpeaker}" Fill="{DynamicResource LiquidGlassForeground}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="音量" FontSize="{DynamicResource FontSizeBody}" Foreground="#555" Width="34" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="2" Minimum="0" Maximum="100" Value="50" Margin="8,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{DynamicResource IconSun}" Fill="{DynamicResource LiquidGlassForeground}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="亮度" FontSize="{DynamicResource FontSizeBody}" Foreground="#555" Width="34" VerticalAlignment="Center"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="2" Minimum="0" Maximum="100" Value="70" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="2" CornerRadius="0,0,14,14" Padding="0,12,0,14">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock x:Name="SongTitle" Text="未在播放" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource LiquidGlassForeground}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SongArtist" Text="" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource LiquidGlassForeground}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnPrevious" Width="48" Height="48" Background="Transparent" BorderThickness="0" ToolTip.Tip="上一首">
                                <Path Data="{DynamicResource IconPrev}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="18" Height="18" />
                            </Button>

                            <Button x:Name="BtnPlayPause" Width="48" Height="48" Margin="26,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="暂停 / 播放">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="PlayPauseIcon" Text="⏸" FontSize="20" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path x:Name="PlayPausePlay" Data="{DynamicResource IconPlay}" Fill="{DynamicResource AccentBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="True" />
                                    <Path x:Name="PlayPausePause" Data="{DynamicResource IconPause}" Fill="{DynamicResource AccentBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                                </Grid>
                            </Button>

                            <Button x:Name="BtnNext" Width="48" Height="48" Background="Transparent" BorderThickness="0" ToolTip.Tip="下一首">
                                <Path Data="{DynamicResource IconNext}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
