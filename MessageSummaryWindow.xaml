<Window x:Class="Notifier.MessageSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="未读通知"
        Width="370"
        Height="315"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 入场 -->
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                From="-420" To="0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- 退场 -->
        <Storyboard x:Key="SlideOutAnimation">
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                To="-420" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.25"/>
        </Storyboard>

        <!-- Liquid glass resources -->
        <SolidColorBrush x:Key="GlassTextBrush" Color="#FF1C1C1E"/>
        <SolidColorBrush x:Key="GlassSecondaryTextBrush" Color="#77000000"/>
        <LinearGradientBrush x:Key="GlassBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#DDF3F4F6" Offset="0"/>
            <GradientStop Color="#CCF8F9FA" Offset="0.45"/>
            <GradientStop Color="#B3F2F4F6" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#26FFFFFF"/>
        <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="GlassInnerGlow" Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.06"/>
        <DropShadowEffect x:Key="GlassShadowEffect" Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.12"/>

        <!-- Entrance scale -->
        <Storyboard x:Key="ScaleInAnimation">
            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.985" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.985" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Item hover animations -->
        <Storyboard x:Key="ItemHoverIn">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.14" Duration="0:0:0.12" />
        </Storyboard>
        <Storyboard x:Key="ItemHoverOut">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.06" Duration="0:0:0.12" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
                <TranslateTransform X="-420"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="14"
                Background="{StaticResource GlassBackgroundBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0.8"
                Effect="{StaticResource GlassShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="Transparent"
                        CornerRadius="14,14,0,0"
                        Padding="14,10">
                    <TextBlock Text="📢 未读通知"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource GlassTextBrush}" VerticalAlignment="Center"/>
                </Border>

                <!-- 消息列表 -->
                <ScrollViewer Grid.Row="1"
                              Margin="12,8,12,8"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="True">
                    <ItemsControl x:Name="MessageList" IsHitTestVisible="True"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" CornerRadius="8"
                                        Background="#14000000"
                                        Padding="12,8"
                                        Margin="0,4"
                                        Cursor="Hand"
                                        Tag="{Binding Title}"
                                        MouseLeftButtonDown="MessageItem_MouseLeftButtonDown"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.06"/>
                                        </Border.Effect>
                                    <StackPanel>
                                        <!-- 标题行 -->
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource GlassTextBrush}"
                                                   TextWrapping="Wrap"/>

                                        <!-- 正文条目 -->
                                        <ItemsControl ItemsSource="{Binding Bodies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource GlassSecondaryTextBrush}"
                                                               Margin="14,2,0,2"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 来源应用 -->
                                        <TextBlock Text="{Binding SourceApp}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource GlassSecondaryTextBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,4,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <!-- 无来源时隐藏整行 -->
                                                        <DataTrigger Binding="{Binding SourceApp}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SourceApp}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.14" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.06" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 底部 -->
                <Border Grid.Row="2"
                        Background="#E2E2E2"
                        CornerRadius="0,0,14,14"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="0"
                                   FontSize="11"
                                   Foreground="#777"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ClearButton"
                                Grid.Column="1"
                                Content="清除全部"
                                Click="ClearButton_Click"
                                Background="#D32F2F"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="11"
                                Padding="10,5"
                                Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
