<Window x:Class="Notifier.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notifier"
        Title="控制中心"
        Width="370" Height="315"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters to normalize Play/Pause text coming from SMTC and map to Visibility -->
            <local:PlayPauseTextToStateConverter x:Key="PlayPauseConverter"/>
            <local:PlayPauseToVisibilityConverter x:Key="PlayPauseToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>


    <!-- ==================== 主体 UI ==================== -->
    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform X="-420"/>
        </Grid.RenderTransform>

        <Border CornerRadius="14"
                Background="{StaticResource LiquidGlassBackground}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" Effect="{StaticResource GlassShadow}" CacheMode="BitmapCache">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="{StaticResource LiquidGlassBackground}" CornerRadius="14,14,0,0" Padding="14,10">
                    <TextBlock Text="控制中心" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTitle}" Foreground="{StaticResource LiquidGlassForeground}"/>
                </Border>

                <!-- 中间：音量与亮度 -->
                <StackPanel Grid.Row="1" Margin="22,20,22,10" VerticalAlignment="Center">
                    <!-- 音量 -->
                    <DockPanel Margin="0,0,0,20">
                        <Path Data="{StaticResource IconSpeaker}" Style="{StaticResource IconPathStyle}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="音量" FontSize="{StaticResource FontSizeBody}" Foreground="#555" Width="34" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider"
                                Minimum="0" Maximum="100" Value="50"
                                Template="{StaticResource VolumeSliderTemplate}"
                                IsSnapToTickEnabled="False"
                                Margin="8,0,0,0"/>
                    </DockPanel>

                    <!-- 亮度 -->
                    <DockPanel>
                        <Path Data="{StaticResource IconSun}" Style="{StaticResource IconPathStyle}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="亮度" FontSize="{StaticResource FontSizeBody}" Foreground="#555" Width="34" VerticalAlignment="Center"/>
                        <Slider x:Name="BrightnessSlider"
                                Minimum="0" Maximum="100" Value="70"
                                Template="{StaticResource BrightnessSliderTemplate}"
                                IsSnapToTickEnabled="False"
                                Margin="8,0,0,0"/>
                    </DockPanel>
                </StackPanel>

                <!-- 底部：媒体控制 + 歌曲信息 -->
                <Border Grid.Row="2" Background="{StaticResource LiquidGlassBackground}" CornerRadius="0,0,14,14" Padding="0,12,0,14">
                    <StackPanel>
                        <!-- 新增：歌曲名称与作者 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock x:Name="SongTitle" 
                                       Text="未在播放" 
                                       FontSize="{StaticResource FontSizeTitle}" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource LiquidGlassForeground}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" — " 
                                       FontSize="{StaticResource FontSizeBody}" 
                                       Foreground="#888" 
                                       VerticalAlignment="Center"
                                       Margin="3,0"/>
                            <TextBlock x:Name="SongArtist" 
                                       Text="未知艺术家" 
                                       FontSize="{StaticResource FontSizeBody}" 
                                       Foreground="{StaticResource LiquidGlassForeground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 原有的媒体控制按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnPrevious"
                                    Style="{StaticResource CircleMediaBtn}"
                                    ToolTip="上一首">
                                <Path Data="{StaticResource IconPrev}" Style="{StaticResource ActionIconStyle}" Width="18" Height="18"/>
                            </Button>

                            <Button x:Name="BtnPlayPause"
                                    Style="{StaticResource CircleMediaBtn}"
                                    Margin="26,0"
                                    ToolTip="暂停 / 播放">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="PlayPauseIcon" Text="⏸" FontSize="20" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="PlayPausePlay" Data="{StaticResource IconPlay}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding Text, ElementName=PlayPauseIcon, Converter={StaticResource PlayPauseToVisibilityConverter}, ConverterParameter=Play}">
                                                                                                                <Path.Style>
                                                                                <Style TargetType="Path" BasedOn="{StaticResource ActionIconStyle}">
                                                                                                                                                                    <Setter Property="Opacity" Value="0.01"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Text, ElementName=PlayPauseIcon, Converter={StaticResource PlayPauseConverter}}" Value="Play">
                                                                                                                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                                                                                                                </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                    <Path x:Name="PlayPausePause" Data="{StaticResource IconPause}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding Text, ElementName=PlayPauseIcon, Converter={StaticResource PlayPauseToVisibilityConverter}, ConverterParameter=Pause}">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path" BasedOn="{StaticResource ActionIconStyle}">
                                                                                                                                                                    <Setter Property="Opacity" Value="0.01"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Text, ElementName=PlayPauseIcon, Converter={StaticResource PlayPauseConverter}}" Value="Pause">
                                                                                                                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                                                                                                                </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnNext"
                                    Style="{StaticResource CircleMediaBtn}"
                                    ToolTip="下一首">
                                <Path Data="{StaticResource IconNext}" Style="{StaticResource ActionIconStyle}" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>