<Window x:Class="Notifier.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Rectangle Window"
Height="Auto" Width="Auto"
MinHeight="40" MinWidth="160"
MaxWidth="360"
WindowStyle="None"
AllowsTransparency="True"
Background="Transparent"
ResizeMode="NoResize"
WindowStartupLocation="Manual"
SizeToContent="WidthAndHeight"
ShowInTaskbar="False"
Visibility="Hidden">

<Window.Resources>
<Storyboard x:Key="SlideInAnimation">
<DoubleAnimation 
Storyboard.TargetName="RootGrid" 
Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" 
From="80" To="0" Duration="0:0:0.25">
<DoubleAnimation.EasingFunction>
<CubicEase EasingMode="EaseOut"/>
</DoubleAnimation.EasingFunction>
</DoubleAnimation>
<DoubleAnimation 
Storyboard.TargetName="RootGrid" 
Storyboard.TargetProperty="Opacity" 
From="0" To="1" Duration="0:0:0.25"/>
</Storyboard>

<Storyboard x:Key="SlideOutAnimation">
<DoubleAnimation 
Storyboard.TargetName="RootGrid" 
Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" 
From="0" To="80" Duration="0:0:0.35">
<DoubleAnimation.EasingFunction>
<CubicEase EasingMode="EaseIn"/>
</DoubleAnimation.EasingFunction>
</DoubleAnimation>
<DoubleAnimation 
Storyboard.TargetName="RootGrid" 
Storyboard.TargetProperty="Opacity" 
From="1" To="0" Duration="0:0:0.30"/>
</Storyboard>

<!-- Liquid glass resources (lightweight, no expensive blur) -->
<SolidColorBrush x:Key="GlassTextBrush" Color="#FF1C1C1E"/>
<SolidColorBrush x:Key="GlassSecondaryTextBrush" Color="#77000000"/>
<LinearGradientBrush x:Key="GlassBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#CCFFFFFF" Offset="0"/>
    <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
    <GradientStop Color="#99FFFFFF" Offset="1"/>
</LinearGradientBrush>
<SolidColorBrush x:Key="GlassBorderBrush" Color="#30FFFFFF"/>
<LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#33FFFFFF" Offset="0"/>
    <GradientStop Color="#0FFFFFFF" Offset="1"/>
</LinearGradientBrush>
<DropShadowEffect x:Key="GlassShadowEffect" Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.12"/>
</Window.Resources>

<Grid x:Name="RootGrid" Opacity="0">
<Grid.RenderTransform>
<TranslateTransform X="60"/>
</Grid.RenderTransform>

<Border CornerRadius="12"
        BorderBrush="{StaticResource GlassBorderBrush}"
        BorderThickness="0.6"
        Padding="0"
        Margin="0"
        Background="{StaticResource GlassBackgroundBrush}"
        Effect="{StaticResource GlassShadowEffect}">
    <Grid Margin="16,10,16,12">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

        <!-- subtle inner sheen -->
        <Border CornerRadius="11" IsHitTestVisible="False" Margin="0">
            <Border.Background>
                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                    <VisualBrush.Visual>
                        <Rectangle Fill="{StaticResource GlassHighlightBrush}"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>

<Grid Grid.Row="0" Margin="0,0,0,6">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBlock Grid.Column="0"
Text="🔔"
FontSize="13"
VerticalAlignment="Center"
Margin="0,0,6,0"/>
<TextBlock Grid.Column="1"
Text="通知"
Foreground="{StaticResource GlassTextBrush}"
FontSize="11"
FontWeight="SemiBold"
VerticalAlignment="Center"/>
<TextBlock Grid.Column="2"
x:Name="TimeStampText"
Foreground="#55000000"
FontSize="10"
VerticalAlignment="Center"/>
</Grid>

<ScrollViewer Grid.Row="1"
MaxHeight="350"
VerticalScrollBarVisibility="Auto"
HorizontalScrollBarVisibility="Disabled"
CanContentScroll="True">
<ItemsControl x:Name="MessageList"
IsHitTestVisible="False"
VirtualizingStackPanel.IsVirtualizing="True"
VirtualizingStackPanel.VirtualizationMode="Recycling">
    <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border CornerRadius="8"
Background="#18000000"
Padding="10,7"
Margin="0,3">
<StackPanel>
<TextBlock Text="{Binding Title}"
Foreground="{StaticResource GlassTextBrush}"
FontSize="12"
FontWeight="SemiBold"
TextWrapping="Wrap"
Margin="0,0,0,5"
HorizontalAlignment="Left"/>

<ItemsControl ItemsSource="{Binding Bodies}"
IsHitTestVisible="False">
<ItemsControl.ItemTemplate>
<DataTemplate>
<TextBlock Text="{Binding}"
Foreground="{StaticResource GlassSecondaryTextBrush}"
FontSize="11"
TextWrapping="Wrap"
Margin="14,2,0,2"
HorizontalAlignment="Left"/>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</ScrollViewer>
</Grid>
</Border>
</Grid>
</Window>