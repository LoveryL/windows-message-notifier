<Window x:Class="Notifier.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Rectangle Window"
Width="375" Height="75"
MinHeight="40" MinWidth="160"
WindowStyle="None"
AllowsTransparency="True"
Background="Transparent"
ResizeMode="NoResize"
WindowStartupLocation="Manual"
ShowInTaskbar="False"
Visibility="Hidden"
Loaded="Window_Loaded_Extended"
Closing="Window_Closing">

<Window.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ThemeResources.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- Fade in/out storyboards for minimal animation changes -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12"/>
        </Storyboard>

    </ResourceDictionary>
</Window.Resources>

<Grid x:Name="RootGrid" Opacity="0">
    <Grid.RenderTransform>
        <TranslateTransform X="0"/>
    </Grid.RenderTransform>

    <Border x:Name="OuterBorder" CornerRadius="10"
                Background="#99FFFFFF"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                Padding="8"
                Margin="6"
                Effect="{StaticResource GlassShadow}"
                CacheMode="BitmapCache">

        <!-- Single-item layout optimized for 375x75 -->
        <ItemsControl x:Name="MessageList" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="359" Height="59">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icon -->
                            <Viewbox Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconBell}" Style="{StaticResource IconPathStyle}"/>
                            </Viewbox>

                            <!-- Title + Body -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource LiquidGlassForeground}" TextTrimming="CharacterEllipsis"/>
                                <ItemsControl ItemsSource="{Binding Bodies}" IsHitTestVisible="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeBody}" Foreground="#AA000000" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Timestamp at top-right, process name bottom-right (tail-aligned with leading ellipsis if too long) -->
                            <Grid Grid.Column="2" Width="100" Margin="8,4,4,0" HorizontalAlignment="Right">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding Time, StringFormat='{}{0:t}'}" Foreground="{StaticResource LiquidGlassForeground}" FontSize="{StaticResource FontSizeCaption}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="{Binding ProcessName}" Foreground="#888888" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" FlowDirection="RightToLeft"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Border>
</Grid>
</Window>