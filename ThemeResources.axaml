<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!--
      所有可被设置面板修改的项都在这里给出默认值。
      运行时由 ThemeManager 在应用级资源上覆盖同名键，因此不需要重启即可生效。
    -->

    <!-- 面板 / 控制中心共用 -->
    <Color x:Key="LiquidGlassBackgroundColor">#AFFFFFFF</Color>
    <SolidColorBrush x:Key="LiquidGlassBackground" Color="#AFFFFFFF" />
    <SolidColorBrush x:Key="LiquidGlassForeground" Color="#FF1C1C1E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#40FFFFFF" />

    <!-- 弹窗 -->
    <SolidColorBrush x:Key="PopupBackground" Color="#ACFFFFFF" />
    <SolidColorBrush x:Key="PopupForeground" Color="#FF1C1C1E" />
    <SolidColorBrush x:Key="PopupBodyText" Color="#AA000000" />
    <SolidColorBrush x:Key="PopupMutedText" Color="#FF888888" />

    <!-- 消息卡片 -->
    <SolidColorBrush x:Key="CardBackground" Color="#12000000" />
    <SolidColorBrush x:Key="CardTitleText" Color="#CC000000" />
    <SolidColorBrush x:Key="CardBodyText" Color="#88000000" />
    <SolidColorBrush x:Key="CardSubText" Color="#FF777777" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#FFFF3B30" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD32F2F" />

    <!-- Ctrl 交互高亮 -->
    <SolidColorBrush x:Key="CtrlHoldBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CtrlReleaseBrush" Color="#ACFFFFFF" />

    <SolidColorBrush x:Key="GlassShadowBrush" Color="#000000" Opacity="0.25" />

    <!-- 圆角 / 字号：由 ThemeManager 覆盖 -->
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>

    <sys:Double x:Key="FontSizeTitle">13</sys:Double>
    <sys:Double x:Key="FontSizeBody">11</sys:Double>
    <sys:Double x:Key="FontSizeCaption">10</sys:Double>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei, sans-serif</FontFamily>

    <Geometry x:Key="IconBell">M12,2 C9,2 7,4 7,7 L7,15 L5,17 L19,17 L17,15 L17,7 C17,4 15,2 12,2 Z M12,20 C13.1,20 14,19.1 14,18 L10,18 C10,19.1 10.9,20 12,20 Z</Geometry>
    <Geometry x:Key="IconSpeaker">M3,9 L7,9 L11,5 L11,19 L7,15 L3,15 Z M15,8 C16.66,9.33 16.66,14.66 15,16</Geometry>
    <Geometry x:Key="IconSun">M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 Z</Geometry>
    <Geometry x:Key="IconPrev">M14,6 L14,18 L6,12 Z M18,6 L18,18 L16,18 L16,6 Z</Geometry>
    <Geometry x:Key="IconPlay">M6,5 L18,12 L6,19 Z</Geometry>
    <Geometry x:Key="IconPause">M7,5 H11 V19 H7 Z M13,5 H17 V19 H13 Z</Geometry>
    <Geometry x:Key="IconNext">M8,6 L8,18 L14,12 Z M16,6 L16,18 L18,18 L18,6 Z</Geometry>
    <Geometry x:Key="IconSettings">M12,15.5 A3.5,3.5 0 1,0 12,8.5 A3.5,3.5 0 1,0 12,15.5 Z M19.4,13 L21,13 L21,11 L19.4,11 C19.1,10.2 18.7,9.5 18.2,8.9 L19.4,7.7 L18,6.3 L16.8,7.5 C16.2,7 15.5,6.6 14.7,6.3 L14.7,4.7 L12.7,4.7 L12.7,6.3 C11.9,6.6 11.2,7 10.6,7.5 L9.4,6.3 L8,7.7 L9.2,8.9 C8.7,9.5 8.3,10.2 8,11 L6.4,11 L6.4,13 L8,13 C8.3,13.8 8.7,14.5 9.2,15.1 L8,16.3 L9.4,17.7 L10.6,16.5 C11.2,17 11.9,17.4 12.7,17.7 L12.7,19.3 L14.7,19.3 L14.7,17.7 C15.5,17.4 16.2,17 16.8,16.5 L18,17.7 L19.4,16.3 L18.2,15.1 C18.7,14.5 19.1,13.8 19.4,13 Z</Geometry>

</ResourceDictionary>
