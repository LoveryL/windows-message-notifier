<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Notifier"
        x:Class="Notifier.MessageSummaryWindow"
        Title="未读通知"
        Width="360" Height="300"
        MinWidth="360" MinHeight="300"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        SystemDecorations="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Notifier/ThemeResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform X="-420"/>
        </Grid.RenderTransform>
        <Border CornerRadius="20"
                Background="{DynamicResource LiquidGlassBackground}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 8 24 0 #00000024">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Path Data="{DynamicResource IconBell}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="未读通知" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource LiquidGlassForeground}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="10,6,10,6" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MessageList" IsHitTestVisible="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ToastMessageGroup">
                                <Border CornerRadius="16"
                                        Background="#12000000"
                                        Padding="12,10"
                                        Margin="0,5"
                                        IsHitTestVisible="True"
                                        Cursor="Hand"
                                        PointerPressed="MessageItem_PointerPressed"
                                        PointerMoved="MessageItem_PointerMoved"
                                        PointerReleased="MessageItem_PointerReleased"
                                        PointerCaptureLost="MessageItem_PointerCaptureLost"
                                        RenderTransform="{x:Null}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FontSizeTitle}"
                                                       Foreground="#CC000000"
                                                       TextWrapping="Wrap" />

                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding HasHiddenMessages}"
                                                    Background="#FF3B30"
                                                    CornerRadius="999"
                                                    Width="18" Height="18"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HiddenCountText}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <ItemsControl Grid.Row="1"
                                                      Margin="0,2,0,0"
                                                      ItemsSource="{Binding VisibleMessages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ToastData">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Body}"
                                                                   FontSize="{DynamicResource FontSizeBody}"
                                                                   Foreground="#88000000"
                                                                   Margin="14,2,0,2"
                                                                   TextWrapping="Wrap" />

                                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,4,0">
                                                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                                                       FontSize="10"
                                                                       Foreground="#888888"
                                                                       HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding SourceApp}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="#777777"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,4,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding SourceApp, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" CornerRadius="0,0,20,20" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="0"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource LiquidGlassForeground}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ClearButton"
                                Grid.Column="1"
                                Content="清除全部"
                                Click="ClearButton_Click"
                                Background="#D32F2F"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="{DynamicResource FontSizeBody}"
                                Padding="10,5"
                                Cursor="Hand" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
