<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Notifier"
        x:Class="Notifier.MessageSummaryWindow"
        Title="未读通知"
        Width="360" Height="300"
        MinWidth="360" MinHeight="300"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        SystemDecorations="None">

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform X="-420"/>
        </Grid.RenderTransform>
        <Border x:Name="OuterBorder"
                CornerRadius="20"
                Background="{DynamicResource LiquidGlassBackground}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Path Data="{DynamicResource IconBell}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="未读通知" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource LiquidGlassForeground}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 横向滚动必须禁用：卡片右滑露出动作区时会往右溢出容器，
                     若允许横向滚动会被撑出一条横向滚动条。 -->
                <ScrollViewer Grid.Row="1" Margin="10,6,10,6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="MessageList" IsHitTestVisible="True">
                        <!-- 启用 UI 虚拟化：原来用默认 StackPanel，进入面板时所有分组
                             （最多数百个，每个还带一个嵌套 ItemsControl）会被一次性实例化并布局，
                             消息一多就会有明显的打开卡顿。 -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ToastMessageGroup">
                                <!-- 外层容器：动作层在下、内容卡片在上。
                                     卡片向右平移时，下面的动作层按位移宽度逐渐露出（iOS 风格）。
                                     注意：动作层用 Grid 而不是 Border —— 指针事件会冒泡，
                                     如果它是 Border，会被 MessageItem_PointerPressed 误判成卡片本体。 -->
                                <Grid Margin="0,5">
                                    <Grid Name="ActionLayer"
                                          IsVisible="False"
                                          Width="0"
                                          HorizontalAlignment="Left"
                                          ClipToBounds="True">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Name="ActionDeleteButton"
                                                    Click="ActionDelete_Click"
                                                    Width="56"
                                                    VerticalAlignment="Stretch"
                                                    Background="#E5484D"
                                                    BorderThickness="0"
                                                    CornerRadius="10,0,0,10"
                                                    Padding="0">
                                                <Path Width="18" Height="18" Stretch="Uniform"
                                                      Stroke="White" StrokeThickness="1.6"
                                                      Data="M4 7h16M10 7V4h4v3M6 7l1 13h10l1-13M9 11v6M15 11v6" />
                                            </Button>
                                            <Button Name="ActionActivateButton"
                                                    Click="ActionActivate_Click"
                                                    Width="56"
                                                    VerticalAlignment="Stretch"
                                                    Background="{DynamicResource AccentBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    Padding="0">
                                                <Path Width="18" Height="18" Stretch="Uniform"
                                                      Stroke="White" StrokeThickness="1.6"
                                                      Data="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                <Border Name="MessageCard"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Background="{DynamicResource CardBackground}"
                                        Padding="12,10"
                                        IsHitTestVisible="True"
                                        Cursor="Hand"
                                        PointerPressed="MessageItem_PointerPressed"
                                        PointerMoved="MessageItem_PointerMoved"
                                        PointerReleased="MessageItem_PointerReleased"
                                        PointerCaptureLost="MessageItem_PointerCaptureLost"
                                        RenderTransform="{x:Null}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FontSizeTitle}"
                                                       Foreground="{DynamicResource CardTitleText}"
                                                       TextWrapping="Wrap" />

                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding HasHiddenMessages}"
                                                    Background="{DynamicResource BadgeBrush}"
                                                    CornerRadius="999"
                                                    Width="18" Height="18"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HiddenCountText}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <ItemsControl Grid.Row="1"
                                                      Margin="0,2,0,0"
                                                      ItemsSource="{Binding VisibleMessages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ToastData">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Body}"
                                                                   FontSize="{DynamicResource FontSizeBody}"
                                                                   Foreground="{DynamicResource CardBodyText}"
                                                                   Margin="14,2,0,2"
                                                                   TextWrapping="Wrap" />

                                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,4,0">
                                                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource CardSubText}"
                                                                       HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding SourceApp}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource CardSubText}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,4,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding SourceApp, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" CornerRadius="0,0,20,20" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="0"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource LiquidGlassForeground}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ClearButton"
                                Grid.Column="1"
                                Content="清除全部"
                                Click="ClearButton_Click"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="{DynamicResource FontSizeBody}"
                                Padding="10,5"
                                Cursor="Hand" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
