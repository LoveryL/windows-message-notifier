<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
<TargetPlatform>windows</TargetPlatform>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    
    <PackageId>LoveryL.WindowsMessageNotifier</PackageId>
    <PackageDisplayName>Windows Message Notifier</PackageDisplayName>
    <PackagePublisher>CN=Levoy</PackagePublisher>
    
    <PackageCertificateKeyFile>..\Notifier.pfx</PackageCertificateKeyFile>
    <PackageVersion>1.2.0.1</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/icon_normal.ico" />
    <EmbeddedResource Include="Resources/icon_alert.ico" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <!-- Exclude test runner and other tooling helpers from the main project compile globbing -->
  <ItemGroup>
    <Compile Remove="TestRunner\**\*.cs" />
  </ItemGroup>

</Project>